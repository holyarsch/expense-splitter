# PostgreSQL connection (matches docker-compose service "db")
DATABASE_URL="postgresql://expense_user:expense_pass@localhost:5432/expense_splitter?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN="http://localhost:5173"

# Cookie
COOKIE_NAME="expense_token"
COOKIE_SECURE=false

# SMTP (used to email the new user their username/password on signup)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="Expense Splitter <your-email@gmail.com>"
