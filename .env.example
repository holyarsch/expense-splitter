# Copy this file to `.env` in the project root — docker-compose reads it automatically.

JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# SMTP (Gmail example: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Expense Splitter <your-email@gmail.com>
